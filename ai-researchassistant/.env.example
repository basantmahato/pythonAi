# Application Settings
APP_NAME="Personal Intelligence System"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Storage Settings
# When running with Docker Compose:
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/personal_intelligence"
# SQLite fallback if Docker PostgreSQL is not running:
SQLITE_FALLBACK_URL="sqlite:///./data/personal_intelligence.db"

# Qdrant Vector Store
# When running with Docker:
QDRANT_URL="http://localhost:6333"
# Local persistent file path if Docker Qdrant is not running:
QDRANT_LOCAL_PATH="./data/qdrant_storage"
QDRANT_COLLECTION="personal_memories_v1"

# Redis Cache
REDIS_URL="redis://localhost:6379/0"

# Embedding Model
# Options: 'BAAI/bge-base-en-v1.5' (768d), 'all-MiniLM-L6-v2' (384d), 'nomic-ai/nomic-embed-text-v1.5' (768d)
EMBEDDING_MODEL_NAME="BAAI/bge-base-en-v1.5"
EMBEDDING_DIMENSION=768

# LLM Provider Configuration
DEFAULT_LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Ingestion & Memory Parameters
MAX_CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
CONFLICT_SIMILARITY_THRESHOLD=0.88
MIN_CONFIDENCE_THRESHOLD=0.70
